# Copy this file to ".env" and fill in the values. Never commit the real .env file.

# PLACEHOLDER (required): your platform's secret API key.
# Stripe Dashboard -> Developers -> API keys -> "Secret key". Use a TEST key (sk_test_...) while building.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# PLACEHOLDER (needed for the requirements webhook): the signing secret (whsec_...) of your event destination.
# Running locally? `stripe listen ...` prints one (see README.md). Deployed? Dashboard -> Developers -> Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Public root URL of this app. Stripe sends people back here after onboarding and checkout.
# Leave as-is for local testing; use your real https:// address when deployed.
APP_URL=http://localhost:4242

# Port to listen on.
PORT=4242

# Percentage of each sale the platform keeps (OverVibez keeps 15).
APPLICATION_FEE_PERCENT=15

# Default country for new connected accounts (two letters, lower case).
DEFAULT_ACCOUNT_COUNTRY=gb
